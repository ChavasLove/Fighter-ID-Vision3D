# FighterID Vision Engine — variables de entorno
# ─────────────────────────────────────────────
# Copia este archivo como .env y completa los valores reales:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
#
# El archivo .env NO se versiona (está en .gitignore).

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://eeshomcqztvjkvycdfwi.supabase.co
SUPABASE_ANON_KEY=sb_publishable_3H9okQFv3LCQv3wxsxiwvg_WdF_f25z

# ── FighterID API (Edge Functions) ────────────────────────────────────
#
# ⚠️  IMPORTANTE — no intercambiar estos dos valores:
#     FIGHTERID_API_KEY  = la CLAVE  (sb_publishable_... o el JWT)
#     FIGHTERID_API_URL  = la URL    (siempre empieza con https://)
#
FIGHTERID_API_KEY=sb_publishable_3H9okQFv3LCQv3wxsxiwvg_WdF_f25z
FIGHTERID_API_URL=https://eeshomcqztvjkvycdfwi.supabase.co/functions/v1/ai-strike-ingest
FIGHTERID_EDGE_URL=https://eeshomcqztvjkvycdfwi.supabase.co/functions/v1

# ── Interruptor general de API ────────────────────────────────────────
# false = motor funciona localmente sin enviar datos a la nube
API_ENABLED=true

# ── Identidad del dispositivo ─────────────────────────────────────────
DEVICE_ID=vision_engine_01

# ── Resolución de cámaras (720p recomendado para USB) ─────────────────
# CAM_W=1280
# CAM_H=720

# ── GPU / inferencia ──────────────────────────────────────────────────
# FORCE_CPU=true   → saltar DML/CUDA — útil cuando aparece "acceso denegado"
# POSE_CONF_THR    → umbral de confianza para detectar personas (0.0–1.0)
#                    0.35 = más sensible (default)  |  0.50 = más estricto
# FORCE_CPU=false
# POSE_CONF_THR=0.35

# ── Umbrales de detección de golpes (ajustar según setup físico) ───────
# STRIKE_SPEED_MS=3.5     # m/s — velocidad mínima de muñeca para contar golpe
# STRIKE_DIST_M=0.15      # m   — distancia máxima al oponente
# STRIKE_COOL_S=0.50      # s   — cooldown entre golpes del mismo luchador
# PIX_PER_M=200.0         # px/m — calibrar según altura de montaje de cámara

# ── Pasar fight_id como variable (alternativa a --fight-id CLI) ────────
# FIGHT_ID=uuid-de-la-pelea-activa
